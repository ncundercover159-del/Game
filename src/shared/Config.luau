--[[
	Config
	======
	Every tunable number and every external ID used by Keep Digging! lives in
	this one module. Paste Developer Product, Game Pass and Subscription IDs in
	the "EXTERNAL IDS" section only; nothing else in the codebase hard-codes an ID.

	Economy numbers here are mirrored in docs/DESIGN.md (generated by
	tools/simulate.luau, which requires this exact module).
]]

local RunService = game:GetService("RunService")

local Config = {}

Config.GameName = "Keep Digging!"
Config.Version = "1.0.0"

------------------------------------------------------------------------------
-- TEST MODE
------------------------------------------------------------------------------
-- When true AND running inside Roblox Studio, every purchase button runs
-- through the exact same server grant path using simulated receipts with
-- unique fake PurchaseIds, and the debug commands are enabled.
-- Hard guard: IsTestMode() is always false outside Studio, so leaving this
-- set to true can never affect a live server. Switch it off before publishing
-- anyway (see SETUP.md).
Config.TestMode = true

function Config.IsTestMode(): boolean
	return Config.TestMode == true and RunService:IsStudio()
end

