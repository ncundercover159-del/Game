{
  "name": "skykart",
  "version": "0.1.0",
  "private": true,
  "description": "SkyKart - a mobile-first arcade kart racer with toy-like elemental racers",
  "type": "module",
  "scripts": {
    "dev": "vite --config client/vite.config.js",
    "build": "vite build --config client/vite.config.js",
    "preview": "vite preview --config client/vite.config.js",
    "server": "node server/index.js",
    "test": "vitest run",
    "loadtest": "node tools/loadtest.js",
    "check-assets": "node tools/check-assets.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.3.0",
    "@fontsource/lilita-one": "^5.3.0",
    "three": "^0.186.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
