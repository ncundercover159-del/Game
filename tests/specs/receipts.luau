local task = require("@lune/task")
-- Receipts, idempotency, pending prompts, gifts and the test-mode guard.
local ServerBoot = require("../harness/ServerBoot")

return function(t)
	t.test("dig receipt grants metres, ledger and a Recent Purchases row", function()
		local boot = ServerBoot.new(t)
		local hole = boot.svc("HoleService")
		local p = boot.addPlayer(101, "Ana")
		t.ok(boot.data(p), "profile loaded")
		local decision = boot.receipt(p, "dig_dynamite", "P-1")
		t.eq(decision, boot.GRANTED, "decision")
		t.near(hole.Depth, 22.5, 1e-9, "hole depth")
		local data = boot.data(p)
		t.ok(data.Ledger["P-1"] ~= nil, "ledger has the PurchaseId")
		t.eq(#data.RecentPurchases, 1, "recent purchases")
		t.eq(data.RecentPurchases[1].Price, 100, "exact price recorded")
		t.near(data.Stats.LifetimeMetres, 22.5, 1e-9, "lifetime contribution")
		-- the grant was persisted before PurchaseGranted
		local saved = boot.store("KD_Profiles_v1"):GetAsync("u_101")
		t.ok(saved.Data.Ledger["P-1"] ~= nil, "ledger persisted")
	end)

	t.test("replaying the same PurchaseId grants nothing twice", function()
		local boot = ServerBoot.new(t)
		local hole = boot.svc("HoleService")
		local p = boot.addPlayer(102, "Bo")
		t.eq(boot.receipt(p, "dig_megadrill", "P-SAME"), boot.GRANTED)
		local depth = hole.Depth
		local recent = #boot.data(p).RecentPurchases
		for _ = 1, 5 do
			t.eq(boot.receipt(p, "dig_megadrill", "P-SAME"), boot.GRANTED, "replay decision")
		end
		t.eq(hole.Depth, depth, "depth unchanged by replays")
		t.eq(#boot.data(p).RecentPurchases, recent, "no extra receipts")
	end)

	t.test("PurchaseGranted only after a successful save; retry never double-grants", function()
		local boot = ServerBoot.new(t)
		local hole = boot.svc("HoleService")
		local p = boot.addPlayer(103, "Cy")
		local store = boot.store("KD_Profiles_v1")
		store._fail.Update = 3 -- the save retries 3 times, all fail
		t.eq(boot.receipt(p, "dig_pickaxe", "P-FAIL"), boot.NOT_YET, "save failed -> NotProcessedYet")
		t.near(hole.Depth, 5.4, 1e-9, "metres credited immediately (visuals/state never wait)")
		t.eq(boot.receipt(p, "dig_pickaxe", "P-FAIL"), boot.GRANTED, "retry succeeds")
		t.near(hole.Depth, 5.4, 1e-9, "no double grant on retry")
		local saved = store:GetAsync("u_103")
		t.ok(saved.Data.Ledger["P-FAIL"] ~= nil, "persisted on retry")
	end)

	t.test("receipts for absent players or unknown products wait", function()
		local boot = ServerBoot.new(t)
		local mps = boot.rt:Service("MarketplaceService")
		t.eq(mps:_receipt(999, -1001, "P-X", 5), boot.NOT_YET, "absent player")
		local p = boot.addPlayer(104, "Di")
		t.eq(mps:_receipt(p.UserId, 123456789, "P-Y", 5), boot.NOT_YET, "unknown product")
	end)

	t.test("one-time item already owned -> closest-value dig compensation", function()
		local boot = ServerBoot.new(t)
		local hole = boot.svc("HoleService")
		local p = boot.addPlayer(105, "Ed")
		t.eq(boot.receipt(p, "skin_gold", "P-G1"), boot.GRANTED)
		t.ok(boot.data(p).Owned.skin_gold, "owned")
		t.eq(boot.data(p).Equipped.ToolSkin, "skin_gold", "auto-equipped")
		local before = hole.Depth
		t.eq(boot.receipt(p, "skin_gold", "P-G2"), boot.GRANTED, "race receipt still granted")
		t.near(hole.Depth - before, 22.5, 1e-9, "compensated with a Dynamite dig (closest to R$ 149)")
		local row = boot.data(p).RecentPurchases[1]
		t.ok(row.Received:find("already owned"), "the receipt says what happened")
	end)

	t.test("exactly one pending prompt per player", function()
		local boot = ServerBoot.new(t)
		local purchase = boot.svc("PurchaseService")
		local p = boot.addPlayer(106, "Fi")
		local first = purchase.Request(p, "dig_pebble", {})
		t.ok(first.ok, "first request ok")
		local second = purchase.Request(p, "dig_shovel", {})
		t.eq(second.ok, false, "second request refused while one is pending")
		local decision = purchase.TestDecision(p, first.token, false)
		t.ok(decision.cancelled, "cancel clears the pending prompt")
		t.ok(purchase.Request(p, "dig_shovel", {}).ok, "new request after cancel")
	end)

	t.test("test-mode simulated receipt uses the real grant path", function()
		local boot = ServerBoot.new(t, {
			Configure = function(rt)
				rt:Require("Shared/Config").Pool.Enabled = false
			end,
		})
		local purchase = boot.svc("PurchaseService")
		local hole = boot.svc("HoleService")
		local p = boot.addPlayer(107, "Gus")
		local req = purchase.Request(p, "dig_bigone", {})
		t.ok(req.ok and req.test, "test prompt issued")
		local result = purchase.TestDecision(p, req.token, true)
		t.ok(result.granted, "granted")
		t.ok(result.purchaseId:sub(1, 5) == "TEST-", "fake PurchaseId")
		t.near(hole.Depth, 2500, 1e-9, "The Big One adds 2,500 m")
		local replay = purchase.ReplayLastTestReceipt(p)
		t.eq(replay, boot.GRANTED, "replay answers granted")
		t.near(hole.Depth, 2500, 1e-9, "but grants nothing")
	end)

	t.test("test mode is hard-guarded to Studio", function()
		local boot = ServerBoot.new(t, {
			Configure = function(rt)
				rt:Service("RunService")._studio = false
			end,
		})
		local Config = boot.rt:Require("Shared/Config")
		t.eq(Config.IsTestMode(), false, "IsTestMode false outside Studio even with TestMode = true")
		local p = boot.addPlayer(108, "Hal")
		local res = boot.svc("PurchaseService").Request(p, "dig_pebble", {})
		t.eq(res.ok, false, "placeholder ids are not purchasable live")
		local dbg = boot.svc("DebugService").Run(p, "AddMetres", { 100 })
		t.eq(dbg.ok, false, "debug commands refused live")
		t.eq(boot.svc("HoleService").Depth, 0, "nothing happened")
	end)

	t.test("gift to a player in the server", function()
		local boot = ServerBoot.new(t)
		local purchase = boot.svc("PurchaseService")
		local a = boot.addPlayer(201, "Ana")
		local b = boot.addPlayer(202, "Bo")
		local req = purchase.Request(a, "skin_neon", { GiftTo = 202 })
		t.ok(req.ok, "gift request ok: " .. tostring(req.reason))
		local res = purchase.TestDecision(a, req.token, true)
		t.ok(res.granted, "granted")
		t.ok(boot.data(b).Owned.skin_neon, "recipient owns it")
		t.eq(boot.data(a).Owned.skin_neon, nil, "sender does not")
		t.ok(boot.data(b).GiftReceipts[res.purchaseId] ~= nil, "recipient gift ledger")
		t.eq(boot.data(a).RecentPurchases[1].To, "Bo", "Recent Purchases names the recipient")
		-- cannot gift an owned one-time item
		local again = purchase.Request(a, "skin_neon", { GiftTo = 202 })
		t.eq(again.ok, false, "recipient already owns it")
	end)

	t.test("dig gift credits the sender on leaderboards and shows A gifted B", function()
		local boot = ServerBoot.new(t)
		local purchase = boot.svc("PurchaseService")
		local hole = boot.svc("HoleService")
		local a = boot.addPlayer(211, "Ana")
		local _b = boot.addPlayer(212, "Bo")
		local req = purchase.Request(a, "dig_excavator", { GiftTo = 212 })
		purchase.TestDecision(a, req.token, true)
		t.near(hole.Depth, 57, 1e-9, "metres added")
		t.near(hole.Contributions["u211"].Metres, 57, 1e-9, "sender credited this hole")
		t.eq(hole.Contributions["u212"], nil, "recipient not credited")
		local feed = boot.svc("FeedService").History()
		t.ok(feed[#feed].Text:find("Ana gifted Bo"), "feed: " .. feed[#feed].Text)
	end)

	t.test("gift recipient leaves before the receipt -> delivered on next join, once", function()
		local boot = ServerBoot.new(t)
		local purchase = boot.svc("PurchaseService")
		local a = boot.addPlayer(221, "Ana")
		local b = boot.addPlayer(222, "Bo")
		local req = purchase.Request(a, "plaque_gold", { GiftTo = 222 })
		t.ok(req.ok, "request ok")
		boot.removePlayer(b) -- leaves before the receipt
		local res = purchase.TestDecision(a, req.token, true)
		t.ok(res.granted, "sender's purchase granted (gift queued)")
		local queued = boot.store("KD_PendingGifts_v1"):GetAsync("u222")
		t.eq(#queued.Entries, 1, "gift queued in the pending-gifts DataStore")
		-- Bo rejoins
		local b2 = boot.addPlayer(222, "Bo")
		t.ok(boot.data(b2).Owned.plaque_gold, "delivered on join")
		local after = boot.store("KD_PendingGifts_v1"):GetAsync("u222")
		t.eq(#after.Entries, 0, "queue cleared after a successful save")
		-- leave and rejoin again: nothing new
		boot.removePlayer(b2)
		local b3 = boot.addPlayer(222, "Bo")
		t.ok(boot.data(b3).Owned.plaque_gold, "still owned")
		t.eq(#boot.data(a).RecentPurchases, 1, "sender charged once")
	end)

	t.test("session lock: a second server cannot load a locked profile until stale", function()
		local boot = ServerBoot.new(t)
		local store = boot.store("KD_Profiles_v1")
		store:SetAsync("u_301", { Data = { Version = 1, Shards = 42 }, Session = { JobId = "other-server", Time = os.time() + 0 } })
		-- Clock in the runtime is far ahead of real os.time(), so the lock looks stale to this runtime unless refreshed.
		boot.rt.Clock.Now = os.time() + 10
		local DataService = boot.svc("DataService")
		local Config = boot.rt:Require("Shared/Config")
		Config.Data.LoadRetries = 2
		local p = boot.rt:Service("Players"):_add(301, "Lock")
		t.eq(DataService.Get(p), nil, "not loaded while another server holds the lock")
		-- The final attempt takes the lock over (ProfileService-style) and loads the data.
		local data = boot.waitLoaded(p)
		t.ok(data ~= nil, "loaded after retries")
		t.eq(data.Shards, 42, "kept the stored data")
		local raw = store:GetAsync("u_301")
		t.eq(raw.Session.JobId, boot.rt.game.JobId, "lock now ours")
	end)
end
