-- Entitlements: game passes, upgrade order, Starter Pack, Season Pass, boosts, Shards.
local ServerBoot = require("../harness/ServerBoot")

return function(t)
	t.test("game pass is re-verified with UserOwnsGamePassAsync on join", function()
		local boot = ServerBoot.new(t, {
			Configure = function(rt)
				rt:Require("Shared/Config").GamePassIds.pass_vip = 777
				rt:Service("MarketplaceService")._ownedPasses[901] = { [777] = true }
			end,
		})
		local p = boot.addPlayer(901, "Vip")
		t.ok(boot.data(p).Owned.pass_vip, "pass cached in profile")
		t.eq(p:GetAttribute("VIP"), true, "VIP attribute")
		t.ok(boot.svc("EntitlementService").Has(p, "pass_vip"), "Has")
		t.eq(#boot.data(p).RecentPurchases, 0, "verification is not a purchase")
	end)

	t.test("game pass purchase is granted on PromptGamePassPurchaseFinished", function()
		local boot = ServerBoot.new(t, {
			Configure = function(rt)
				rt:Require("Shared/Config").GamePassIds.pass_2xfree = 778
			end,
		})
		local p = boot.addPlayer(902, "Pat")
		local mps = boot.rt:Service("MarketplaceService")
		mps.PromptGamePassPurchaseFinished:Fire(p, 778, false)
		t.eq(boot.data(p).Owned.pass_2xfree, nil, "cancelled purchase grants nothing")
		mps.PromptGamePassPurchaseFinished:Fire(p, 778, true)
		t.ok(boot.data(p).Owned.pass_2xfree, "granted")
		t.eq(boot.data(p).RecentPurchases[1].Price, 299, "recent purchase with exact price")
		t.ok(boot.svc("BoostService").Flags(p).FreePass, "2x free metres active")
	end)

	t.test("Auto-Digger levels are bought in order, each once", function()
		local boot = ServerBoot.new(t)
		local purchase = boot.svc("PurchaseService")
		local p = boot.addPlayer(903, "Lev")
		t.eq(purchase.Request(p, "auto_lv2", {}).ok, false, "Lv2 needs Lv1")
		t.eq(boot.receipt(p, "auto_lv1", "A-1"), boot.GRANTED)
		t.eq(boot.data(p).AutoDiggerLevel, 1, "level 1")
		t.eq(p:GetAttribute("AutoDiggerLevel"), 1, "bay rig level replicated")
		t.eq(purchase.Request(p, "auto_lv1", {}).ok, false, "Lv1 owned")
		t.ok(purchase.Request(p, "auto_lv2", {}).ok, "Lv2 now allowed")
		-- an out-of-order receipt (race) is compensated, not swallowed
		local hole = boot.svc("HoleService")
		local before = hole.Depth
		t.eq(boot.receipt(p, "auto_lv4", "A-4"), boot.GRANTED)
		t.eq(boot.data(p).AutoDiggerLevel, 1, "level unchanged")
		t.near(hole.Depth - before, 236, 1e-9, "compensated with the closest-value dig (TBM for R$ 799)")
	end)

	t.test("Starter Pack: itemised, one per account, owned contents swapped", function()
		local boot = ServerBoot.new(t)
		local purchase = boot.svc("PurchaseService")
		local hole = boot.svc("HoleService")
		local p = boot.addPlayer(904, "Sam")
		boot.receipt(p, "skin_gold", "S-0")
		local before = hole.Depth
		t.eq(boot.receipt(p, "starter_pack", "S-1"), boot.GRANTED)
		local data = boot.data(p)
		t.ok(data.Owned.starter_pack, "claimed")
		t.eq(data.AutoDiggerLevel, 1, "Lv1 Auto-Digger")
		t.ok(data.Owned.hat_rookie, "Rookie Hard Hat")
		-- Jackhammer dig (11 m) + Gold swapped for a Dynamite dig (22.5 m)
		t.near(hole.Depth - before, 11 + 22.5, 1e-9, "dig contents and swap")
		t.ok(data.RecentPurchases[1].Received:find("swapped"), "swap is itemised")
		t.eq(purchase.Request(p, "starter_pack", {}).ok, false, "one per account")
	end)

	t.test("Season Pass unlocks the premium track; tier skip; claims", function()
		local boot = ServerBoot.new(t)
		local season = boot.svc("SeasonService")
		local p = boot.addPlayer(905, "Sea")
		t.eq(season.Claim(p, "Premium", 1).ok, false, "premium needs the pass")
		t.eq(boot.receipt(p, "season_tierskip", "T-1"), boot.GRANTED)
		t.eq(season.Tier(p), 1, "tier skip completes tier 1")
		t.eq(boot.receipt(p, "season_pass", "SP-1"), boot.GRANTED)
		t.ok(boot.data(p).Season.Premium, "premium")
		local claim = season.Claim(p, "Premium", 1)
		t.ok(claim.ok, "claimed tier 1 premium")
		t.ok(boot.data(p).Owned.hat_rookie, "reward granted")
		t.eq(season.Claim(p, "Premium", 1).ok, false, "claims once")
		t.eq(season.Claim(p, "Premium", 3).ok, false, "tier not reached")
	end)

	t.test("boosts: expiry survives in the profile, stacking extends time", function()
		local boot = ServerBoot.new(t)
		local boosts = boot.svc("BoostService")
		local p = boot.addPlayer(906, "Bea")
		t.eq(boot.receipt(p, "boost_personal_30", "BP-1"), boot.GRANTED)
		local expiry = boot.data(p).Boosts.PersonalExpiry
		t.eq(expiry, boot.rt.Clock.Now + 1800, "30 minutes from now")
		boot.receipt(p, "boost_personal_120", "BP-2")
		t.eq(boot.data(p).Boosts.PersonalExpiry, expiry + 7200, "stacked time")
		t.ok(boosts.PersonalActive(p), "active")
		boot.rt:Advance(10000)
		t.eq(boosts.PersonalActive(p), false, "expired")
		t.eq(boot.receipt(p, "boost_server", "BS-1"), boot.GRANTED)
		t.ok(boosts.ServerActive(), "server boost on")
		t.eq(p:GetAttribute("ServerHero"), true, "Server Hero tag")
		local other = boot.addPlayer(907, "Oli")
		t.ok(boosts.Flags(other).Server, "everyone in the server benefits")
	end)

	t.test("shards only come from play", function()
		local boot = ServerBoot.new(t)
		local shards = boot.svc("ShardService")
		local p = boot.addPlayer(908, "Sha")
		t.throws(function()
			shards.Add(p, 100, "Purchase")
		end, "Shards may only come from play")
		shards.Add(p, 300, "Obby:Beginner")
		t.ok(shards.Buy(p, "plaque_wood").ok, "bought Wood plaque with Shards")
		t.eq(boot.data(p).Shards, 0, "spent")
		t.eq(boot.data(p).Equipped.PlaqueStyle, "plaque_wood", "equipped")
		t.eq(shards.Buy(p, "plaque_gold").ok, false, "Robux items can't be bought with Shards")
	end)

	t.test("equip validates ownership and slot", function()
		local boot = ServerBoot.new(t)
		local cos = boot.svc("CosmeticsService")
		local p = boot.addPlayer(909, "Eq")
		t.eq(cos.Equip(p, "ToolSkin", "skin_galaxy").ok, false, "not owned")
		t.eq(cos.Equip(p, "HardHat", "skin_classic").ok, false, "wrong slot")
		t.ok(cos.Equip(p, "ToolSkin", "skin_classic").ok, "default item")
		boot.receipt(p, "skin_galaxy", "E-1")
		t.ok(cos.Equip(p, "ToolSkin", "skin_galaxy").ok, "owned now")
		t.eq(p:GetAttribute("Eq_ToolSkin"), "skin_galaxy", "replicated for the next dig")
	end)

	t.test("plaque message is filtered; dedication requires a 100 R$+ dig", function()
		local boot = ServerBoot.new(t)
		local cos = boot.svc("CosmeticsService")
		local purchase = boot.svc("PurchaseService")
		local p = boot.addPlayer(910, "Msg")
		t.eq(cos.SetPlaqueMessage(p, "hi").ok, false, "needs the unlock")
		boot.receipt(p, "plaque_message", "M-1")
		local res = cos.SetPlaqueMessage(p, "hello badword friends")
		t.ok(res.ok, "set")
		t.eq(res.filtered, "hello ####### friends", "filtered text is what shows")
		t.eq(purchase.Request(p, "dig_pebble", { Dedication = "for mum" }).ok, false, "no dedication under 100 R$")
		local req = purchase.Request(p, "dig_dynamite", { Dedication = "for mum" })
		t.ok(req.ok, "dedication with a 100 R$ dig")
	end)
end
