{
  "name": "hej",
  "private": true,
  "version": "0.1.0",
  "description": "Hej! \u2014 a pixel-art game that takes English speakers from zero to conversational Danish.",
  "type": "module",
  "scripts": {
    "content": "tsx scripts/build-content.ts",
    "audio": "tsx scripts/tts.ts",
    "audio:dry": "tsx scripts/tts.ts --dry-run",
    "audio:voices": "tsx scripts/tts.ts --list-voices",
    "icons": "tsx scripts/make-icons.ts",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc --noEmit && vite build",
    "preview": "vite preview",
    "check": "npm run content && tsc --noEmit",
    "test": "npm run content && vitest run",
    "artifact": "npm run content && tsx scripts/artifact.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.129.0"
  }
}
